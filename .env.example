# ---- LLM (pick one provider) -------------------------------------------
LLM_PROVIDER=groq                 # groq | ollama
GROQ_API_KEY=gsk_...              # free key: https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-20b
JUDGE_MODEL=openai/gpt-oss-20b   # used by eval/run_eval.py + RAGAS

# OLLAMA_MODEL=llama3.1:8b        # if LLM_PROVIDER=ollama (run: ollama pull llama3.1:8b)
# OLLAMA_BASE_URL=http://localhost:11434

# ---- Embeddings (local, free) ------------------------------------------
EMBEDDING_BACKEND=bge             # bge | hashing (tests only)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Chunking / retrieval ----------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
HYBRID=true                       # dense + BM25 with reciprocal rank fusion
DENSE_K=12
BM25_K=12

# ---- Paths -------------------------------------------------------------
DOCS_DIR=data/docs
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=sbp_docs
